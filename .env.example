# Copie para .env e preencha. O .env fica só na sua máquina: não envie o arquivo a ninguém.

# Banco de dados: dados do app (anúncios, usuários etc.)
# No Supabase: Connect > Session pooler. Funciona em redes IPv4 e IPv6; a conexão direta só em IPv6.
# Caracteres especiais da senha precisam estar codificados (ex.: @ vira %40).
DATABASE_URL=postgresql://postgres.PROJETO:SENHA@HOST.pooler.supabase.com:5432/postgres

# Supabase Storage: envio das fotos dos anúncios (não usa a DATABASE_URL)
# No Supabase: Project Settings > API Keys. A chave de serviço dá acesso total ao projeto.
SUPABASE_URL=https://PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua-chave-de-servico
